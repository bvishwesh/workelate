# ==============================================================================
# WorkElate AI Agent - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (SQLite default with clean PostgreSQL migration path)
DATABASE_URL=sqlite+aiosqlite:///./workelate.db

# LLM Configuration (Optional: will use intelligent offline fallback if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CLI Execution Security & Safety Limits
CLI_EXECUTION_TIMEOUT_SECONDS=60
MAX_CRAWL_DEPTH=3
MAX_CRAWL_PAGES=15
CRAWLER_USER_AGENT=WorkElateCrawlerBot/1.0 (+https://github.com/workelate)
ALLOW_INTERNAL_IPS=false
